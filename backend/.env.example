# Only needed if you start nodes by hand (scripts/local_cluster.sh generates its own secrets)
NODE_ID=api-1
PORT=8000
DATABASE_URL=postgres://secureshare:secureshare@localhost:5432/secureshare
JWT_SECRET_KEY=change-me
JWT_MAXAGE=60
MASTER_KEY=<64 hex chars: openssl rand -hex 32>
CLUSTER_TOKEN=dev-cluster-token
STORAGE_NODES=s1=http://localhost:9001,s2=http://localhost:9002,s3=http://localhost:9003,s4=http://localhost:9004,s5=http://localhost:9005
REPLICATION_FACTOR=3
WRITE_QUORUM=2
# storage node (separate process):  NODE_ID=s1 PORT=9001 DATA_DIR=./storage-data/s1 CLUSTER_TOKEN=...  cargo run --release --bin storage_node
